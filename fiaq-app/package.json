{
  "name": "fiaq-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && vite build",
    "dev": "cross-env TMPDIR=/tmp vite dev --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "build:faq": "node scripts/build-faq.mjs",
    "seed:faq": "node scripts/seed-faq.mjs",
    "seed:knowledge": "node scripts/seed-knowledge.mjs",
    "index:rag": "node scripts/build-rag-index.mjs",
    "fetch:links": "node scripts/fetch-links.mjs",
    "discover:unb": "node scripts/discover-unb-sources.mjs",
    "fetch:unb": "node scripts/discover-unb-sources.mjs --write-crawl",
    "research:unb:browser": "python3 scripts/research-unb-browser-use.py",
    "test:openrouter": "node scripts/test-openrouter.mjs",
    "lint": "eslint .",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@lucide/svelte": "^1.21.0",
    "@supabase/supabase-js": "2.108.2",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.67.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tanstack/svelte-query": "^6.1.35",
    "@tanstack/table-core": "^8.21.3",
    "bits-ui": "^2.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "isomorphic-dompurify": "^3.18.0",
    "jspdf": "^4.2.1",
    "marked": "^18.0.4",
    "pdf-parse": "^2.4.5",
    "postgres": "^3.4.9",
    "svelte": "^5.56.4",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^26.0.0",
    "@types/pdf-parse": "^1.1.5",
    "cross-env": "^7.0.3",
    "eslint": "^10.2.0",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.7.0",
    "svelte-check": "^4.7.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.18.0"
  }
