# ─── Providers de LLM / Embeddings ──────────────────────────────────────────
# Valores: "ollama" (local, padrão) ou "openrouter"
CHAT_PROVIDER=ollama
EMBED_PROVIDER=ollama

# ─── OpenRouter (necessário se algum provider acima for "openrouter") ────────
OPENROUTER_API_KEY=
# Modelo gratuito fixo para chat/texto. Evita a aleatoriedade do openrouter/free.
OPENROUTER_CHAT_MODEL=google/gemma-4-31b-it:free
# Fallbacks gratuitos caso o modelo principal esteja rate-limited/indisponível.
OPENROUTER_CHAT_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-super-120b-a12b:free
# OpenRouter streaming: valida este mínimo de caracteres antes de emitir tokens.
# Default: 32. Menor reduz latência inicial; maior aumenta a filtragem prévia.
# mínimo efetivo: 32, para filtrar respostas-classificador antes do streaming
OPENROUTER_STREAM_PREFLIGHT_CHARS=32
# Embeddings precisam ficar no mesmo modelo/dimensão usados no seed do RAG.
# Não use openrouter/free aqui: ele é roteador de chat, não endpoint de embeddings.
OPENROUTER_EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free

# ─── Pesquisa web sob demanda (Firecrawl) ────────────────────────────────────
# Usado quando o aluno pede complemento e também como fallback automático quando
# uma pergunta de escopo UnB não tem contexto local forte ou depende de atualidade.
FIRECRAWL_API_URL=
# Opcional se FIRECRAWL_API_URL apontar para um proxy próprio sem autenticação.
FIRECRAWL_API_KEY=
FIRECRAWL_INCLUDE_DOMAINS=cic.unb.br,www.cic.unb.br,unb.br,www.unb.br,saa.unb.br,sigaa.unb.br
FIRECRAWL_TRUSTED_DOMAINS=unb.br,cic.unb.br,noticias.unb.br,informa.unb.br,saa.unb.br,sigaa.unb.br,adunb.org,sintfub.org.br,correiobraziliense.com.br,metropoles.com,brasildefato.com.br
FIRECRAWL_SEARCH_LIMIT=6
FIRECRAWL_BROAD_SEARCH_LIMIT=8
FIRECRAWL_TIMEOUT_MS=30000
FIRECRAWL_FRESH_MAX_AGE_MS=86400000

# ─── Área administrativa / Supabase Auth ────────────────────────────────────
# Usado pelo /admin. A URL e a anon key são públicas; a service role é server-only.
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=
# Alternativa server-side para validação admin; se ausente, o servidor usa VITE_*.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# E-mails que entram como administradores mesmo antes de existirem na tabela
# admin_usuario. Use só para bootstrap inicial; depois prefira convites.
ADMIN_BOOTSTRAP_EMAILS=
# URL canônica usada nos convites do Supabase Auth. Defina no Coolify/self-host
# (ex.: https://fiaq.porto.ooo); na Vercel, VERCEL_URL cobre se ficar vazio.
ADMIN_BASE_URL=

# ─── Ollama (local) — sobrescreve os defaults se quiser ──────────────────────
# OLLAMA_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=qwen2.5:7b
# OLLAMA_EMBED_MODEL=nomic-embed-text

# ─── Opcional ────────────────────────────────────────────────────────────────
# URL pública do app, usada no header HTTP-Referer do OpenRouter (atribuição).
# Na Vercel é preenchida automaticamente via VERCEL_URL; no Coolify, defina.
# APP_URL=https://fiaq.porto.ooo
# Seed: máximo de embeddings novos gerados por execução (padrão 40). Trechos já
# presentes em server/assets/rag-index.json são reaproveitados sem gastar cota.
# SEED_MAX_EMBEDDINGS=40

# ─── Banco de Dados ───────────────────────────────────────────────────────────
# Sem DATABASE_URL, o chat usa o fallback server/assets/rag-index.json.
# Postgres local (Docker, sem SSL):
# DATABASE_URL=postgresql://fiaq:fiaq123@localhost:5432/fiaq
# Coolify (Supabase self-hosted, rede interna; use o nome completo do container):
# DATABASE_URL=postgresql://USUARIO:SENHA@supabase-db-<id-do-servico>:5432/postgres
# Banco gerenciado (Neon, Supabase, Vercel Postgres — com SSL obrigatório):
# DATABASE_URL=postgresql://usuario:senha@host:5432/fiaq?sslmode=require
# Supabase + Vercel: prefira a Transaction Pooler URI (porta 6543) com SSL.
# O app usa postgres.js com prepare=false para compatibilidade com o pooler.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@REGIAO.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
