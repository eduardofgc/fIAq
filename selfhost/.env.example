# fIAq self-host — copie para .env e preencha (NUNCA commite o .env)

# URL pública do app (a VM/domínio que o professor liberar)
APP_URL=http://SEU_HOST:3000

# URL pública do Supabase self-hosted (Kong). As VITE_* são embutidas no bundle
# do browser no build — precisam ser alcançáveis pelo navegador dos usuários.
VITE_SUPABASE_URL=http://SEU_HOST:8000
VITE_SUPABASE_ANON_KEY=<ANON_KEY gerada no .env do supabase/docker>
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY gerada no .env do supabase/docker>
# Opcional: URL interna do Kong pra chamadas server-side (mesma rede docker)
SUPABASE_INTERNAL_URL=http://kong:8000

# Postgres do stack Supabase, via rede interna do docker (serviço "db")
# A senha do fiaq_app é definida com ALTER ROLE (ver README passo 4)
DATABASE_URL=postgresql://fiaq_app:TROQUE_ESTA_SENHA@db:5432/postgres

# Admins que podem se logar no painel mesmo sem convite prévio (CSV)
ADMIN_BOOTSTRAP_EMAILS=fernando.hor.ren@gmail.com

# LLM / embeddings (mesmos valores usados na Vercel)
CHAT_PROVIDER=openrouter
EMBED_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=
OPENROUTER_CHAT_FALLBACK_MODELS=
OPENROUTER_EMBED_MODEL=

# Pesquisa web (opcional)
FIRECRAWL_API_URL=
FIRECRAWL_API_KEY=
FIRECRAWL_INCLUDE_DOMAINS=
